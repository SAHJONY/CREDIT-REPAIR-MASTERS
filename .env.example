# Server-side only. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
CREDIT_OS_API_TOKEN=
CREDIT_OS_ORGANIZATION_ID=org_credit_repair_masters

# Production persistence.
DATABASE_URL=

# Managed Neon Auth. Keep the cookie secret server-side and at least 32 characters.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# One-time owner credential bootstrap. Generate a long random value, use it to activate approved owner emails,
# then remove this variable from Vercel after owner accounts exist.
OWNER_ACTIVATION_SECRET=

# Customer portal invitations. Generate a dedicated random value of at least 32 characters.
# If omitted, the runtime uses MFA_ENCRYPTION_KEY with domain-separated HMAC signing.
PORTAL_INVITE_SECRET=

# Legacy/fallback auth secret if needed by future adapters.
AUTH_SECRET=

# Production infrastructure mode. Vercel production enforces sensitive routes fail-closed.
APP_ENV=demo

# Evidence vault: connect a Vercel Blob store with access=Private.
# Vercel injects this token when the private store is connected to the project.
# Never use a public Blob store for credit reports, identity documents, or other client evidence.
EVIDENCE_VAULT_PROVIDER=vercel-private-blob
BLOB_READ_WRITE_TOKEN=

# Public acquisition funnel. Configure at least one approved delivery channel.
# The application records PII-minimized conversion metadata in the audit ledger; full prospect contact data
# is delivered only to the configured business webhook or email destination.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=
RESEND_API_KEY=
LEADS_NOTIFICATION_EMAIL=
LEADS_FROM_EMAIL=

# External provider and jurisdiction rules remain fail-closed until explicitly configured.
CREDIT_DATA_PROVIDER=
STATE_RULES_VERSION=

# Payment processors. Add secrets only in the hosting provider's encrypted environment store.
# Square: Square-hosted Checkout API plus signed webhook settlement.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://credit-repair-masters.vercel.app/api/payments/square/webhook
# Optional: set to sandbox for Square sandbox API calls. Production is the default.
SQUARE_ENVIRONMENT=production

# Stripe: hosted customer checkout and verified payment settlement.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal wallet and eligible hosted card checkout.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Authorize.Net backup card gateway.
AUTHORIZE_NET_API_LOGIN_ID=
AUTHORIZE_NET_TRANSACTION_KEY=
AUTHORIZE_NET_CLIENT_KEY=

# Optional enterprise processor.
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
NEXT_PUBLIC_ADYEN_CLIENT_KEY=

# Zelle is a manual bank-payment/reconciliation rail, not an automatic merchant API.
ZELLE_RECIPIENT=
ZELLE_DISPLAY_NAME=